# Maintainer: LuGG000 <81622672+LuGG000@users.noreply.github.com>
pkgname=switchyard
pkgver=0.3.1
pkgrel=1
pkgdesc='Account switcher with limit failover for Claude Code subscription logins'
arch=('x86_64' 'aarch64')
url='https://github.com/LuGG000/switchyard'
license=('Apache-2.0')
makedepends=('go')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('15098bd1e5db68249a471eb641561e17cd9d83d4a957a372920ad49437569dc5')

build() {
  cd "$pkgname-$pkgver"
  export CGO_ENABLED=0 GOFLAGS='-trimpath -mod=readonly'
  go build -ldflags "-s -w -X main.version=$pkgver" -o "$pkgname" ./cmd/switchyard
}

check() {
  cd "$pkgname-$pkgver"
  go test ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
