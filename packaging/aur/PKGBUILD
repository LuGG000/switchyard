# Maintainer: LuGG000 <81622672+LuGG000@users.noreply.github.com>
pkgname=switchyard
pkgver=0.2.0
pkgrel=1
pkgdesc='Account switcher with limit failover for Claude Code subscription logins'
arch=('x86_64' 'aarch64')
url='https://github.com/LuGG000/switchyard'
license=('Apache-2.0')
makedepends=('go')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('608f6ee44e4ae664d01ff5ef906ed6bb875ecfdad2a6dd2fb804283526f5bfc2')

build() {
  cd "$pkgname-$pkgver"
  export CGO_ENABLED=0 GOFLAGS='-trimpath -mod=readonly'
  go build -ldflags "-s -w -X main.version=$pkgver" -o "$pkgname" ./cmd/switchyard
}

check() {
  cd "$pkgname-$pkgver"
  go test ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
