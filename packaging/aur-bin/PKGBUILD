pkgname=switchyard-bin
pkgver=0.3.0
pkgrel=1
pkgdesc='Account switcher with limit failover for Claude Code subscription logins (prebuilt binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/LuGG000/switchyard'
license=('Apache-2.0')
provides=('switchyard')
conflicts=('switchyard')
source_x86_64=("$url/releases/download/v$pkgver/switchyard_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/switchyard_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=('4fb6d09f78b4047513fce1155f01cd36b2dbbf3363ac4fd0db6bc26ef30184f6')
sha256sums_aarch64=('fe50631bbc8b5e542892b4cde57f5363bf0eeace5ac6814ca23512263958fdb8')

package() {
  install -Dm755 switchyard "$pkgdir/usr/bin/switchyard"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
